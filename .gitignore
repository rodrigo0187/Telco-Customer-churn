# DATOS Y ARTEFACTOS (PROTEGER ALMACENAMIENTO Y PRIVACIDAD)
# Ignorar todos los backups y datos procesados pesados
data/backup/
data/processed/*
results/*

# Ignorar los CSV reales/pesados de producción
data/raw/*
# excepto para testing, puedes mantener un CSV de ejemplo ligero para pruebas
!data/processed/X_test.csv
!data/processed/Y_test.csv

# Ignorar modelos entrenados pesados (Render o Git no deben almacenar binarios grandes)
models/*.pkl

# ENTORNO Y CONFIGURACIONES SENSIBLES
# ¡NUNCA SUBIR EL .ENV! Las credenciales se ponen directamente en el panel de Render
.env

# ENTORNO DE DESARROLLO Y BASURA DE PYTHON
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
*.ipynb

# ==============================================================================
# DOCKER (LOCAL VS PRODUCCIÓN)
# ==============================================================================
# Mantenemos Dockerfile visible para Render, pero puedes ignorar el compose local si deseas
# (Es una buena práctica subir ambos para que tu equipo sepa cómo correrlo local)
# docker-compose.yml  <-- RECOMIENDO COMENTARLO (QUITAR EL #) PARA SUBIRLO AL REPO
